{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "household-app",
  "compatibility_date": "2025-11-17",
  "main": "virtual:photon:cloudflare:server-entry",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  // D1データベース（支出・予算・認証データ用）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "household-db",
      "database_id": "91552f81-4280-49ed-b9f0-5534d41a0a34",
      "migrations_dir": "database/migrations"
    }
  ],
  "limits": {
    "cpu_ms": 60000, // default is 30000 (30 seconds)
  },
  // 環境変数（シークレット）の設定方法:
  // ローカル開発: .dev.vars.example をコピーして .dev.vars を作成
  // 本番環境: wrangler secret put コマンドまたはCloudflare Dashboardで設定
  // 詳細は AUTH_SETUP.md および .dev.vars.example を参照
  // カスタムドメイン設定
  "routes": [
    {
      "pattern": "maronn-household-budget.com/*",
      "zone_name": "maronn-household-budget.com"
    },
    {
      "pattern": "www.maronn-household-budget.com/*",
      "zone_name": "maronn-household-budget.com"
    }
  ]
}