# Better Auth設定（サーバーサイド）
# openssl rand -base64 32 などで生成した32文字以上のランダム文字列
BETTER_AUTH_SECRET=your-random-secret-string-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Better Auth設定（クライアントサイド / Vike）
# フロントエンドからBetter Authサーバーにアクセスする際のベースURL
# 本番環境では実際のドメインに変更してください
# Vikeの環境変数規約に従い、PUBLIC_ENV__ プレフィックスを使用
# @see https://vike.dev/env
PUBLIC_ENV__BETTER_AUTH_URL=http://localhost:3000

# Webhook設定
# Webhookシークレットの暗号化に使用する鍵
# openssl rand -base64 32 などで生成した32文字以上のランダム文字列
WEBHOOK_SECRET_KEY=your-webhook-secret-key-min-32-chars
