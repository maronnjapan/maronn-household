{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "household-app",
  "compatibility_date": "2025-11-17",
  "main": "virtual:photon:cloudflare:server-entry",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  // D1データベース（支出・予算・認証データ用）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "household-db",
      "database_id": "91552f81-4280-49ed-b9f0-5534d41a0a34",
      "migrations_dir": "database/migrations"
    }
  ],
  "limits": {
    "cpu_ms": 60000, // default is 30000 (30 seconds)
  },
  // シークレット: HOUSEHOLD_CLIENT_SECRET（household-auth と同じ値。デプロイが投入）、WEBHOOK_SECRET_KEY など
  // BETTER_AUTH_SECRET は移行期間だけ旧 Better Auth のセッション Cookie の検証に使う
  // ローカル開発は .dev.vars.example をコピーして .dev.vars を作成
  // gateway（household-gateway）から service binding で呼ばれる。ルートと workers.dev は持たない
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // 認証基盤の issuer（= 公開オリジン）
    "OIDC_ISSUER": "https://maronn-household-budget.com"
  },
  // 認証基盤（トークン交換・JWKS・アカウント削除）。同じゾーンの URL への fetch は Worker を経由しないため service binding で呼ぶ
  "services": [{ "binding": "AUTH", "service": "household-auth" }]
}
