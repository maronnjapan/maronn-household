# Supabase PostgreSQL接続文字列（マイグレーション用）
# Supabaseプロジェクト設定 > Database > Connection string > Direct connection
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Better Auth設定（サーバーサイド）
# openssl rand -base64 32 などで生成した32文字以上のランダム文字列
BETTER_AUTH_SECRET=your-random-secret-string-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Better Auth設定（クライアントサイド / Vike）
# フロントエンドからBetter Authサーバーにアクセスする際のベースURL
# 本番環境では実際のドメインに変更してください
# Vikeの環境変数規約に従い、PUBLIC_ENV__ プレフィックスを使用
# @see https://vike.dev/env
PUBLIC_ENV__BETTER_AUTH_URL=http://localhost:3000

# AWS SES 設定（お問い合わせメール送信）
# AWS IAM でアクセスキーを作成し、SES の送信権限を付与してください
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1

# お問い合わせメール受信先アドレス
# お問い合わせを受け取るメールアドレス
CONTACT_EMAIL_TO=your-email@example.com

# お問い合わせメール送信元アドレス
# AWS SES で検証済みのメールアドレスまたはドメイン
# 例: noreply@yourdomain.com
CONTACT_EMAIL_FROM=noreply@yourdomain.com
