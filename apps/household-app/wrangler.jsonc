{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "household-app",
  "compatibility_date": "2025-09-06",
  "main": "virtual:photon:cloudflare:server-entry",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  // D1データベース（支出・予算データ用）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "household-db",
      "database_id": "91552f81-4280-49ed-b9f0-5534d41a0a34",
      "migrations_dir": "database/migrations"
    }
  ],
  // PostgreSQL接続用のHyperdrive（認証データ用）
  // Hyperdriveの設定方法: wrangler hyperdrive create <name> --connection-string="postgresql://..."
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "YOUR_HYPERDRIVE_ID_HERE"
    }
  ],
  // 環境変数
  "vars": {
    "AUTH0_DOMAIN": "YOUR_AUTH0_DOMAIN",
    "AUTH0_CLIENT_ID": "YOUR_AUTH0_CLIENT_ID",
    "AUTH0_CLIENT_SECRET": "YOUR_AUTH0_CLIENT_SECRET",
    "BETTER_AUTH_SECRET": "YOUR_BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL": "http://localhost:5173"
  }
}