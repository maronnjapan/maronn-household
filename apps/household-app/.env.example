# Supabase PostgreSQL接続文字列（マイグレーション用）
# Supabaseプロジェクト設定 > Database > Connection string > Direct connection
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Auth0設定
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Better Auth設定（サーバーサイド）
BETTER_AUTH_SECRET=your-random-secret-string-min-32-chars
BETTER_AUTH_URL=http://localhost:5173

# Better Auth設定（クライアントサイド / Vite）
# フロントエンドからBetter Authサーバーにアクセスする際のベースURL
# 本番環境では実際のドメインに変更してください
VITE_BETTER_AUTH_URL=http://localhost:5173

# Cloudflare Hyperdrive ID（wrangler hyperdrive createで取得）
HYPERDRIVE_ID=your-hyperdrive-id
