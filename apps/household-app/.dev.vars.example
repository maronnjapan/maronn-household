# Cloudflare Workers ローカル開発用環境変数の例
# wrangler dev でアプリを実行する際に読み込まれます
# このファイルを .dev.vars にコピーして、実際の値を設定してください

# Better Auth設定
# openssl rand -base64 32 などで生成した32文字以上のランダム文字列
BETTER_AUTH_SECRET=your-random-secret-string-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Webhook設定
# Webhookシークレットの暗号化に使用する鍵
# openssl rand -base64 32 などで生成した32文字以上のランダム文字列
WEBHOOK_SECRET_KEY=your-webhook-secret-key-min-32-chars

# Node環境
NODE_ENV=development

# AWS SES設定（お問い合わせメール送信用）
# Terraformで作成されたIAMユーザーのアクセスキーを設定
# 詳細は docs/aws-ses-setup.md を参照
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-northeast-1

# お問い合わせメール設定
# SESで検証済みのドメインのメールアドレスを指定
CONTACT_EMAIL_FROM=noreply@yourdomain.com
CONTACT_EMAIL_TO=admin@yourdomain.com
