{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "delete-expired-session-cron",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-03",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"0 20 * * *"
		]
	},
	// D1データベース（認証データ用）
	// household-appと同じD1データベースを使用
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "household-db",
			"database_id": "91552f81-4280-49ed-b9f0-5534d41a0a34"
		}
	]
}
