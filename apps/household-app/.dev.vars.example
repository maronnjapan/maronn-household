# Cloudflare Workers ローカル開発用環境変数の例
# このファイルを .dev.vars にコピーして、実際の値を設定してください

# 認証基盤（apps/auth-server、household-auth）の issuer。ローカルでは household-app の開発サーバーのオリジン
# （http のときはセッション Cookie に Secure / __Host- を付けない）
OIDC_ISSUER=http://localhost:3000
# 認証基盤に登録する家計簿アプリのクライアントシークレット（apps/auth-server/.dev.vars と同じ値）
HOUSEHOLD_CLIENT_SECRET=your-household-client-secret

# 移行期間だけ: 旧 Better Auth のセッション Cookie の検証に使う（本番の値を使い続ける）
BETTER_AUTH_SECRET=your-random-secret-string-min-32-chars

# Webhook設定
# Webhookシークレットの暗号化に使用する鍵
# openssl rand -base64 32 などで生成した32文字以上のランダム文字列
WEBHOOK_SECRET_KEY=your-webhook-secret-key-min-32-chars

# Node環境
NODE_ENV=development

# メール送信設定（Resend）
# https://resend.com/ のダッシュボードでAPIキーを発行
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com
